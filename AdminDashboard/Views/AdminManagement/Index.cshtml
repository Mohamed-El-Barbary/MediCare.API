@model IEnumerable<AdminDataDTO>
<div class="content-wrapper">

    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success auto-alert">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger auto-alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Page Header -->
    <div class="page-header">
        <h3 class="page-title">
            <span class="page-title-icon bg-gradient-primary text-white me-2">
                <i class="mdi mdi-account-key"></i>
            </span>
            Admins Management
        </h3>
        <nav aria-label="breadcrumb">
            <ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="../index.html">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Admins</li>
            </ul>
        </nav>
    </div>

    <!-- Add Admin Button -->
    <div class="row mb-3">
        <div class="col-12 d-flex justify-content-end">
            <a asp-action="AddAdmin" asp-controller="AdminManagement" class="btn btn-gradient-primary">
                <i class="mdi mdi-plus"></i> Add Admin
            </a>
        </div>
    </div>

    @if (Model?.Any() == true)
    {
        <!-- Admins Table -->
        <div class="row">
            <div class="col-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">

                        <h4 class="card-title">All Admins</h4>
                        <p class="card-description">Manage system administrators and roles</p>

                        <div class="table-responsive">
                            <table class="table table-hover">

                                <thead>
                                    <tr>
                                        <th>Full Name</th>
                                        <th>Email</th>
                                        <th>UserName</th>
                                        <th>Phone</th>
                                        <th>Role</th>
                                        <th>Join Date</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var user in Model)
                                    {

                                        <!-- Admin Row -->
                                        <tr>
                                            <td>@user.FullName</td>
                                            <td>@user.Email</td>
                                            <td>@user.UserName</td>
                                            <td>@user.Phone</td>
                                            <td>
                                                <label class="badge badge-gradient-success">@user.Role</label>
                                            </td>
                                            <td>@user.CreatedAt</td>
                                            <td>
                                                <div class="d-flex align-items-center gap-1">
                                                    <a class="btn btn-sm btn-outline-primary" asp-controller="AdminManagement" asp-action="EditAdmin" asp-route-id="@user.Id">
                                                        <i class="mdi mdi-account-edit"></i>
                                                    </a>
                                                    <div class="dropdown" style="position:static">
                                                        <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="dropdown">
                                                            <i class="mdi mdi-dots-vertical"></i>
                                                        </button>
                                                        <ul class="dropdown-menu dropdown-menu-end status-dropdown">
                                                            <li>
                                                                <button type="button"
                                                                        class="dropdown-item delete-btn"
                                                                        data-id="@user.Id"
                                                                        data-bs-toggle="modal"
                                                                        data-bs-target="#deleteModal">
                                                                    <i class="mdi mdi-delete"></i> Delete
                                                                </button>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }

                                </tbody>
                            </table>
                        </div>
                        <!-- Pagination -->

                    </div>
                </div>
            </div>
        </div>
    }

</div>

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-scrollable">
        <form asp-action="DeleteConfirmed" asp-controller="AdminManagement" method="post">
            <input type="hidden" name="id" id="deleteId" />

            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Admin</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    Are you sure you want to delete this admin?
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-danger">
                        Yes, Delete
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts
{
    <partial name="_AlertsScripts" />
    <partial name="_ModelsScripts" />
}