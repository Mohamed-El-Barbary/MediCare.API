@using Health.Domain.Entities.IdentityModule
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var user = await UserManager.GetUserAsync(User);
}
<nav class="sidebar sidebar-offcanvas" id="sidebar">
    <ul class="nav">
        <!-- Profile -->
        <li class="nav-item nav-profile">
            <a href="#" class="nav-link">
                @if (user != null)
                {
                    <div class="position-relative d-inline-flex align-items-center justify-content-center">

                        <!-- Avatar -->
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                             style="width:40px; height:40px; font-size:20px;">
                            <i class="mdi mdi-account text-white"></i>
                        </div>

                        <!-- Status -->
                        <span class="position-absolute bottom-0 end-0 translate-middle p-1 bg-success border border-light rounded-circle">
                            <span class="visually-hidden">Online</span>
                        </span>

                    </div>
                    <div class="d-flex flex-column ms-3">
                        <span class="font-weight-bold mb-2"> @user.FirstName @user.LastName</span>
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="text-secondary text-small">@UserManager.GetRolesAsync(user).Result.FirstOrDefault()</span>
                            <i class="mdi mdi-bookmark-check text-success nav-profile-badge"></i>
                        </div>
                    </div>
                }
            </a>
        </li>

        <!-- Dashboard -->
        <li class="nav-item">
            <a class="nav-link" asp-controller="Home" asp-action="Index">
                <span class="menu-title">Dashboard</span>
                <i class="mdi mdi-home menu-icon"></i>
            </a>
        </li>

        <!-- Doctors Management -->
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="collapse" href="#doctors" aria-expanded="false" aria-controls="doctors">
                <span class="menu-title">Doctors</span>
                <i class="menu-arrow"></i>
                <i class="mdi mdi-stethoscope menu-icon"></i>
            </a>
            <div class="collapse" id="doctors">
                <ul class="nav flex-column sub-menu">
                    <li class="nav-item"><a class="nav-link" asp-controller="Doctors" asp-action="Index">All Doctors</a></li>
                </ul>
            </div>
        </li>

        <!-- Patients Management -->
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="collapse" href="#patients" aria-expanded="false" aria-controls="patients">
                <span class="menu-title">Patients</span>
                <i class="menu-arrow"></i>
                <i class="mdi mdi-account-multiple-outline menu-icon"></i>
            </a>
            <div class="collapse" id="patients">
                <ul class="nav flex-column sub-menu">
                    <li class="nav-item"><a class="nav-link" href="../pages/patients/list.html">All Patients</a></li>
                    <li class="nav-item"><a class="nav-link" href="../pages/patients/blocked.html">Blocked Patients</a></li>
                </ul>
            </div>
        </li>

        <!-- Appointments -->
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="collapse" href="#appointments" aria-expanded="false" aria-controls="appointments">
                <span class="menu-title">Appointments</span>
                <i class="menu-arrow"></i>
                <i class="mdi mdi-calendar-check menu-icon"></i>
            </a>
            <div class="collapse" id="appointments">
                <ul class="nav flex-column sub-menu">
                    <li class="nav-item"><a class="nav-link" href="../pages/appointments/today.html">Today</a></li>
                    <li class="nav-item"><a class="nav-link" href="../pages/appointments/week.html">This Week</a></li>
                </ul>
            </div>
        </li>

        <!-- Payments -->
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="collapse" href="#payments" aria-expanded="false" aria-controls="payments">
                <span class="menu-title">Payments</span>
                <i class="menu-arrow"></i>
                <i class="mdi mdi-cash-multiple menu-icon"></i>
            </a>
            <div class="collapse" id="payments">
                <ul class="nav flex-column sub-menu">
                    <li class="nav-item"><a class="nav-link" href="../pages/payments/collected.html">Collected</a></li>
                    <li class="nav-item"><a class="nav-link" href="../pages/payments/pending.html">Pending Refunds</a></li>
                </ul>
            </div>
        </li>

        <!-- Notifications -->
        <li class="nav-item">
            <a class="nav-link" href="../pages/notifications.html">
                <span class="menu-title">Notifications</span>
                <i class="mdi mdi-bell menu-icon"></i>
            </a>
        </li>

        <!-- Admin Users -->
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="collapse" href="#users" aria-expanded="false" aria-controls="users">
                <span class="menu-title">Admin Users</span>
                <i class="menu-arrow"></i>
                <i class="mdi mdi-account menu-icon"></i>
            </a>
            <div class="collapse" id="users">
                <ul class="nav flex-column sub-menu">
                    <li class="nav-item"><a class="nav-link" asp-controller="AdminManagement" asp-action="Index">All Users</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="AdminManagement" asp-action="AddAdmin">Add User</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="AdminManagement" asp-action="Roles">Roles</a></li>
                </ul>
            </div>
        </li>

        <!-- Documentation -->
        <li class="nav-item">
            <a class="nav-link" href="../docs/documentation.html" target="_blank">
                <span class="menu-title">Documentation</span>
                <i class="mdi mdi-file-document-box menu-icon"></i>
            </a>
        </li>
    </ul>
</nav>